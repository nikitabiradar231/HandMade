# Midnight network the DApp targets ('undeployed' = local devnet,
# 'preview' / 'preprod' = public testnets). The wallet extension must be
# connected to the same network.
VITE_NETWORK_ID=preview

# Ledger address of the deployed HandMadeHub contract on the selected network
# (recorded in .midnight-state.json after `npm run deploy -- --network ...`).
VITE_CONTRACT_ADDRESS=11f29a415f12812531d87e7c642215ae6d132e10810471d54a0b1025dbfa67bf

# Official public Midnight indexer endpoints (no auth required). These are the
# values the DApp uses for GraphQL contract queries. Do NOT use a wallet
# extension's IAM-gated gateway here (e.g. api-preview.1am.xyz) — those return
# 401 without an authenticated session.
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws

# Leave unset to delegate proving to the wallet extension (dApp Connector v4
# getProvingProvider). Set only when running your own proof server, e.g. the
# local devnet:
# VITE_PROOF_SERVER_URL=http://127.0.0.1:6300