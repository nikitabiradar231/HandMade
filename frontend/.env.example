# Midnight network the wallet must be connected to ('undeployed' = local devnet,
# 'preview' / 'preprod' = public testnets).
VITE_NETWORK_ID=preview

# Ledger address of the deployed HandMadeHub contract on the Preview network
# (recorded in .midnight-state.json after `npm run deploy -- --network preview`).
VITE_CONTRACT_ADDRESS=

# Preview indexer / proof server endpoints used by the wallet's public data and
# proof providers (overrides the wallet's own getConfiguration() when set).
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preview.midnight.network/api/v4/graphql/ws
VITE_PROOF_SERVER_URL=http://127.0.0.1:6300
