# HandMadeHub frontend environment — copy to .env.local and fill in.
# Network the wallet must be connected to (the DApp validates this).
VITE_NETWORK=preview
# Deployed HandMadeHub contract address on the Preview network.
# Fill this after `npm run deploy -- --network preview` prints it.
VITE_CONTRACT_ADDRESS=
# Midnight Preview indexer GraphQL endpoint.
VITE_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
